# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Anthropic API key. Required only for real (non-mock) LLM runs.
ANTHROPIC_API_KEY=

# LLM backend: "mock" runs the pipeline with canned responses and zero API cost.
# "anthropic" uses the real API. Stage 0 defaults to mock.
MTG_LLM_BACKEND=mock

# Model routing. Narrow/high-volume steps use the cheap tier; synthesis uses the strong tier.
# Verify current model IDs against the Anthropic docs before a real run.
MTG_MODEL_CHEAP=claude-haiku-4-5
MTG_MODEL_STRONG=claude-sonnet-4-6

# Path to the local Scryfall SQLite database (built by the ingest step).
MTG_DB_PATH=data/scryfall.sqlite
